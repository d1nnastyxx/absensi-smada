
# Konfigurasi gup di termux untuk global

cat << 'EOF' > ~/.gup.conf
# Konfigurasi Global GitHub Uploader (gup)
GIT_NAME="d1nnastyxx"
GIT_EMAIL="emailkamu@gmail.com"
DEFAULT_BRANCH="main"
DEFAULT_MSG="Update project"
# Opsional: isi jika ingin 1 repo default, atau kosongkan agar ditanya saat setup pertama
REPO_URL=""
EOF

# Uploader github otomatis

cat << 'EOF' > $PREFIX/bin/gup
#!/data/data/com.termux/files/usr/bin/bash

# 1. Muat config global & config lokal project (jika ada)
[ -f "$HOME/.gup.conf" ] && source "$HOME/.gup.conf"
[ -f "./.gup.conf" ] && source "./.gup.conf"

DIR="$(pwd)"
BRANCH="${DEFAULT_BRANCH:-main}"

# Atasi error "dubious ownership" di /sdcard & simpan login GitHub otomatis
git config --global --add safe.directory "$DIR" 2>/dev/null || true
git config --global credential.helper store 2>/dev/null || true
[ -n "$GIT_NAME" ] && git config --global user.name "$GIT_NAME"
[ -n "$GIT_EMAIL" ] && git config --global user.email "$GIT_EMAIL"

# Buat .gitignore otomatis jika belum ada
ensure_gitignore() {
  if [ ! -f ".gitignore" ]; then
    cat << 'IGN' > .gitignore
node_modules/
.env
.env.local
.env.*.local
.vercel/
.gup.conf
*.zip
.DS_Store
Thumbs.db
IGN
    echo "[+] .gitignore otomatis dibuat."
  fi
}

# ==========================================
# DETEKSI: PERTAMA KALI ATAU UPDATE?
# ==========================================
if [ ! -d ".git" ] || ! git remote get-url origin >/dev/null 2>&1; then
  echo "=== [MODE SETUP PERTAMA KALI] ==="
  ensure_gitignore

  if [ -z "$REPO_URL" ]; then
    read -p "Masukkan link repo GitHub (https://github.com/user/repo.git): " REPO_URL
  fi
  if [ -z "$REPO_URL" ]; then
    echo "[!] Link repo tidak boleh kosong."
    exit 1
  fi

  # Simpan config khusus folder project ini
  cat << CFG > ./.gup.conf
REPO_URL="$REPO_URL"
DEFAULT_BRANCH="$BRANCH"
DEFAULT_MSG="${DEFAULT_MSG:-Update project}"
CFG

  [ ! -d ".git" ] && git init
  git branch -M "$BRANCH"
  git remote remove origin 2>/dev/null || true
  git remote add origin "$REPO_URL"

  MSG="${1:-Initial commit}"
  git add -A
  git commit -m "$MSG" || echo "[i] Tidak ada file baru untuk di-commit."

  echo "[*] Mengupload ke $REPO_URL ($BRANCH)..."
  if ! git push -u origin "$BRANCH"; then
    read -p "[?] Push ditolak (repo sudah ada isinya). Paksa timpa (--force)? (y/N): " ANS
    if [[ "$ANS" =~ ^[Yy]$ ]]; then
      git push -u origin "$BRANCH" --force
    fi
  fi
  echo "[OK] Setup & upload pertama selesai!"
else
  echo "=== [MODE UPDATE / COMMIT] ==="
  ensure_gitignore

  # Pastikan file sensitif tidak ikut ter-track
  git rm -r --cached node_modules .env.local .vercel .gup.conf 2>/dev/null || true

  if [ -n "$1" ]; then
    MSG="$1"
  else
    read -p "Pesan commit [Enter = ${DEFAULT_MSG:-Update}]: " INPUT_MSG
    MSG="${INPUT_MSG:-${DEFAULT_MSG:-Update}}"
  fi

  git add -A
  if git diff --cached --quiet; then
    echo "[i] Tidak ada perubahan file. Tidak perlu commit."
    exit 0
  fi

  git commit -m "$MSG"
  git push origin "$BRANCH"
  echo "[OK] Update berhasil di-push ke branch $BRANCH!"
fi
EOF

chmod +x $PREFIX/bin/gup
